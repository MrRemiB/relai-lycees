  "components": {
    "schemas": {
      "Config": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "historical",
              "controlled"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "academy": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "school_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^\\d{7}[A-Z]$",
              "description": "Must exist in loaded official directory."
            },
            "maxItems": 5000,
            "uniqueItems": true
          },
          "source_reference": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              {
                "type": "null"
              }
            ]
          },
          "validated_on": {
            "anyOf": [
              {
                "type": "string",
                "format": "date",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "state": {
            "type": "string",
            "enum": [
              "draft",
              "validated"
            ]
          },
          "mission_modes": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "RCD",
                "rectoral"
              ]
            },
            "maxItems": 2,
            "uniqueItems": true,
            "minItems": 1
          },
          "rcd_max_days": {
            "type": "number",
            "minimum": 1,
            "maximum": 365
          },
          "freshness_days": {
            "type": "number",
            "minimum": 1,
            "maximum": 3650
          },
          "travel_margin_minutes": {
            "type": "number",
            "minimum": 0,
            "maximum": 240
          },
          "out_of_zone": {
            "type": "string",
            "enum": [
              "exclude",
              "review"
            ]
          },
          "mobility_mode": {
            "type": "string",
            "enum": [
              "car",
              "manual"
            ]
          },
          "priority": {
            "type": "string",
            "enum": [
              "urgent_scarcity",
              "scarcity"
            ]
          }
        },
        "required": [
          "mode",
          "label",
          "academy",
          "school_ids",
          "source_reference",
          "validated_on",
          "state",
          "mission_modes",
          "rcd_max_days",
          "freshness_days",
          "travel_margin_minutes",
          "out_of_zone",
          "mobility_mode",
          "priority"
        ],
        "additionalProperties": false
      },
      "Session": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "start": {
            "type": "string",
            "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
          },
          "end": {
            "type": "string",
            "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
          },
          "timezone": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "description": "IANA zone; executable only Europe/Paris; DST ambiguity/gap/change = review."
          },
          "school_id": {
            "type": "string",
            "pattern": "^\\d{7}[A-Z]$",
            "description": "Must exist in loaded official directory."
          }
        },
        "required": [
          "date",
          "start",
          "end",
          "timezone",
          "school_id"
        ],
        "additionalProperties": false
      },
      "Zone": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^Z[A-Za-z0-9_-]{1,63}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "academy": {
            "type": "string"
          },
          "school_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^\\d{7}[A-Z]$",
              "description": "Must exist in loaded official directory."
            },
            "maxItems": 5000,
            "uniqueItems": true
          },
          "adjacent_zone_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^Z[A-Za-z0-9_-]{1,63}$"
            },
            "maxItems": 500,
            "uniqueItems": true
          }
        },
