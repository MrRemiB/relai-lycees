  "openapi": "3.1.0",
  "info": {
    "title": "Relai anonymous business pilot integration",
    "version": "1.0.0",
    "description": "Full replacement anonymous configuration only. This schema does not authorize real RH data, national legal compliance, SSO or payroll. Unknown keys/duplicate JSON keys and references are rejected. No real roster connector exists."
